{
  "name": "mymg",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "studio": "pnpm --filter @mymg/studio studio",
    "compositions": "pnpm --filter @mymg/studio compositions",
    "render": "node tooling/render.mjs",
    "still": "node tooling/still.mjs",
    "check": "node tooling/check-workspace.mjs && pnpm test && pnpm -r --if-present typecheck",
    "check:structure": "node tooling/check-workspace.mjs",
    "test": "node --experimental-strip-types --test tooling/*.test.mjs",
    "qa": "node tooling/check-video.mjs",
    "frames": "node tooling/capture-frames.mjs",
    "portal": "pnpm --filter @mymg/portal dev",
    "build:portal": "pnpm --filter @mymg/portal build",
    "qa:portal": "pnpm --filter @mymg/portal qa"
  },
  "type": "module"
}
